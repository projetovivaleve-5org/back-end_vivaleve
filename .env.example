# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o GitHub.
# Formato: CHAVE=valor (sem aspas, sem espaços em volta do =)

# Porta local da API (troque se a 8080 estiver ocupada no seu PC)
SERVER_PORT=8080

# Banco (Render)
DB_USER=
DB_PASSWORD=

# Login: chave que assina os tokens da API (pelo menos 32 caracteres, a API nem sobe sem ela)
JWT_SECRET=

# Login com Google: Client ID da credencial "Web application" do Google Cloud Console
GOOGLE_CLIENT_ID=

# IA - Groq (plano gratuito): chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Origens do front liberadas no CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
